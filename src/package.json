{
  "name": "xcm",
  "product-name": "XCM",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "build": {
    "asar": true,
    "extraResources": [],
    "files": [
      "*.js",
      "IMG/*.png",
      "*.icns"
    ],
    "artifactName": "${name}-${os}-${arch}-v${version}.${ext}",
    "icon": "XCM.icns",
    "appId": "com.hi.problaze20.xcm",
    "mac": {
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "md5": "^2.3.0",
    "nedb": "^1.8.0"
  }
}
